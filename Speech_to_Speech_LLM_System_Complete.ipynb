  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize waveform and Mel spectrogram\n",
    "fig, axes = plt.subplots(2, 1, figsize=(14, 8))\n",
    "\n",
    "# Plot 1: Waveform (amplitude over time)\n",
    "librosa.display.waveshow(audio_data, sr=sample_rate, ax=axes[0], color='steelblue')\n",
    "axes[0].set_title('Audio Waveform', fontsize=14, fontweight='bold')\n",
    "axes[0].set_xlabel('Time (seconds)')\n",
    "axes[0].set_ylabel('Amplitude')\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 2: Mel Spectrogram (frequency over time)\n",
    "mel_spectrogram = librosa.feature.melspectrogram(\n",
    "    y=audio_data,\n",
    "    sr=sample_rate,\n",
    "    n_mels=80,  # 80 Mel frequency bins (standard for speech)\n",
    "    fmax=8000   # Maximum frequency\n",
    ")\n",
    "mel_spectrogram_db = librosa.power_to_db(mel_spectrogram, ref=np.max)\n",
    "\n",
    "img = librosa.display.specshow(\n",
    "    mel_spectrogram_db,\n",
    "    sr=sample_rate,\n",
    "    x_axis='time',\n",
    "    y_axis='mel',\n",
    "    ax=axes[1],\n",
    "    cmap='viridis'\n",
    ")\n",
    "axes[1].set_title('Mel Spectrogram', fontsize=14, fontweight='bold')\n",
    "axes[1].set_xlabel('Time (seconds)')\n",
    "axes[1].set_ylabel('Frequency (Hz)')\n",
    "fig.colorbar(img, ax=axes[1], format='%+2.0f dB')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n✅ Audio visualization complete!\")"
   ]
