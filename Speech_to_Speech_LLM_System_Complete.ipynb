    "# BONUS: Text-based interaction (skip Whisper)\n",
    "def text_to_speech_assistant(question_text):\n",
    "    \"\"\"\n",
    "    Process a text question and generate spoken response.\n",
    "    Skips Whisper (STT) - goes directly from text → LLM → TTS.\n",
    "    \"\"\"\n",
    "    print(f\"📝 Question: {question_text}\\n\")\n",
    "    \n",
    "    # LLM response\n",
    "    prompt = create_chat_prompt(question_text)\n",
    "    inputs = tokenizer(prompt, return_tensors=\"pt\").to(device)\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        outputs = llm_model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=150,\n",
    "            temperature=0.7,\n",
    "            top_p=0.9,\n",
    "            do_sample=True,\n",
    "            pad_token_id=tokenizer.eos_token_id,\n",
    "            repetition_penalty=1.2\n",
    "        )\n",
    "    \n",
    "    full_response = tokenizer.decode(outputs[0], skip_special_tokens=False)\n",
    "    answer = full_response.split(\"<|assistant|>\")[-1].replace(\"</s>\", \"\").strip()\n",
    "    \n",
    "    print(f\"🤖 Answer: {answer}\\n\")\n",
    "    \n",
    "    # TTS\n",
    "    inputs = processor(text=answer, return_tensors=\"pt\").to(device)\n",
    "    \n",
    "    with torch.no_grad():\n",
