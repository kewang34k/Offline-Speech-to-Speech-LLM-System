    "\n",
    "transcribed_text = result[\"text\"].strip()\n",
    "\n",
    "print(\"=\"*60)\n",
    "print(\"📄 TRANSCRIPTION RESULT:\")\n",
    "print(\"=\"*60)\n",
    "print(f\"{transcribed_text}\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Show detected language and confidence\n",
    "print(f\"\\n🌐 Detected language: {result.get('language', 'en')}\")\n",
    "\n",
    "# Store for next step\n",
    "user_question = transcribed_text"
   ]
