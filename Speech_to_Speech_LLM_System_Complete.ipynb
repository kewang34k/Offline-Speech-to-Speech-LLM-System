    "# BONUS: Interactive voice assistant function\n",
    "def voice_assistant_pipeline(audio_path):\n",
    "    \"\"\"\n",
    "    Complete speech-to-speech pipeline in one function.\n",
    "    \n",
    "    Args:\n",
    "        audio_path: Path to input audio file\n",
    "    \n",
    "    Returns:\n",
    "        tuple: (transcribed_text, llm_response, output_audio_path)\n",
    "    \"\"\"\n",
    "    print(\"🎙️ Step 1: Transcribing audio...\")\n",
    "    result = whisper_model.transcribe(audio_path, language=\"en\")\n",
    "    question = result[\"text\"].strip()\n",
    "    print(f\"   Question: {question}\")\n",
    "    \n",
    "    print(\"\\n🤖 Step 2: Generating response...\")\n",
    "    prompt = create_chat_prompt(question)\n",
    "    inputs = tokenizer(prompt, return_tensors=\"pt\").to(device)\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        outputs = llm_model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=150,\n",
    "            temperature=0.7,\n",
    "            top_p=0.9,\n",
    "            do_sample=True,\n",
    "            pad_token_id=tokenizer.eos_token_id,\n",
    "            repetition_penalty=1.2\n",
    "        )\n",
    "    \n",
    "    full_response = tokenizer.decode(outputs[0], skip_special_tokens=False)\n",
    "    answer = full_response.split(\"<|assistant|>\")[-1].replace(\"</s>\", \"\").strip()\n",
    "    print(f\"   Answer: {answer}\")\n",
    "    \n",
    "    print(\"\\n🔊 Step 3: Synthesizing speech...\")\n",
    "    inputs = processor(text=answer, return_tensors=\"pt\").to(device)\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        speech = tts_model.generate_speech(\n",
    "            inputs[\"input_ids\"],\n",
    "            speaker_embedding,\n",
    "            vocoder=vocoder\n",
    "        )\n",
    "    \n",
    "    speech_audio = speech.cpu().numpy()\n",
    "    output_path = \"assistant_response.wav\"\n",
    "    sf.write(output_path, speech_audio, samplerate=16000)\n",
    "    \n",
    "    print(f\"✅ Complete! Audio saved to: {output_path}\\n\")\n",
    "    \n",
    "    return question, answer, output_path\n",
    "\n",
    "# Example usage\n",
    "print(\"🎯 Interactive Voice Assistant Ready!\\n\")\n",
    "print(\"Usage:\")\n",
    "print('  q, a, path = voice_assistant_pipeline("your_question.wav\")')\n",
    "print('  Then play: Audio(path, rate=16000)\\n')"
